    "@types/react-dom": "^19.2.3",
    "jsdom": "catalog:",
    "shadcn": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
