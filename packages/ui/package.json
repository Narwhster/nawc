{
  "name": "@nawc/ui",
  "version": "0.1.1",
  "description": "React user interface for NAWC notebooks.",
  "keywords": [
    "coding-agents",
    "nawc",
    "notebook",
    "specification-driven-development"
  ],
  "homepage": "https://nawc.dev",
  "bugs": {
    "url": "https://github.com/Narwhster/nawc/issues"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Narwhster/nawc.git",
    "directory": "packages/ui"
  },
  "files": [
    "index.html",
    "src",
    "!src/**/*.test.*"
  ],
  "type": "module",
  "exports": {
    ".": "./src/main.tsx",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "test": "vp test",
    "check": "vp check"
  },
