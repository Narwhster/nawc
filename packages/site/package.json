{
  "name": "@nawc/site",
  "version": "0.1.0",
  "description": "Build static websites from NAWC notebooks.",
  "keywords": [
    "coding-agents",
    "nawc",
    "notebook",
    "specification-driven-development"
  ],
  "homepage": "https://nawc.dev",
  "bugs": {
    "url": "https://github.com/Narwhster/nawc/issues"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Narwhster/nawc.git",
    "directory": "packages/site"
  },
  "bin": {
    "site": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./browser": "./dist/browser.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@nawc/config": "workspace:*",
    "@nawc/core": "workspace:*",
    "@nawc/plugin": "workspace:*",
    "@nawc/ui": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "commander": "^15.0.0",
    "jiti": "^2.7.0",
    "sucrase": "^3.35.1",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
